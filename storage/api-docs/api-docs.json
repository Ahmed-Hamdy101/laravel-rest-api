    "paths": {
        "/v1/users": {
            "get": {
                "tags": [
                    "Users"
                ],
                "summary": "Get users list",
                "description": "Display a paginated list of users.\nExample: GET /api/v1/users?page=2",
                "operationId": "0e69ec7c952b784b446c59d0dc9955ab",
                "parameters": [
                    {
                        "name": "page",
                        "in": "path",
                        "description": "Page number",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful operation"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/users/{id}": {
            "get": {
                "tags": [
                    "Users"
                ],
                "summary": "Show a single user by ID",
                "description": "Show a single user by ID.\nExample: GET /api/v1/users/5",
                "operationId": "e2a9e9265f7be93b919519df96b87cb7",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "The unique identifier of the user",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User details retrieved successfully"
                    },
                    "404": {
                        "description": "User not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "put": {
                "tags": [
                    "Users"
                ],
                "summary": "Update a current user",
                "description": "Update an existing user by ID.\nExample: PUT /api/users/5",
                "operationId": "81fadd62a4c882784f05f43316994719",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "The unique identifier of the user",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateUserRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "202": {
                        "description": "User Updated successfully"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Users"
                ],
                "summary": "Delete a single user by ID",
                "description": "Delete a user by ID.\nExample: DELETE /api/users/5",
                "operationId": "da07da2839b7648faf27d4d36ecba553",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "The unique identifier of the user",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "User Deleted successfully"
                    },
                    "404": {
                        "description": "User not found"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/v1/users/": {
            "post": {
                "tags": [
                    "Users"
                ],
                "summary": "Create a new user",
                "description": "Create a new user.\nExample: GET /api/v1/users/",
                "operationId": "188c8fd9290faa03c570a53897331b11",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateUserRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User created successfully"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "CreateUserRequest": {
                "title": "Create New User ",
                "description": "Create New Record",
                "properties": {
                    "f_name": {
                        "title": "f_name",
                        "description": "Determine if the user is authorized to make this request.",
                        "type": "string"
                    },
                    "l_name": {
                        "title": "l_name",
                        "type": "string"
                    },
                    "email": {
                        "title": "email",
                        "type": "string"
                    },
                    "password": {
                        "title": "password",
                        "type": "string"
                    },
                    "role_id": {
                        "title": "role_id",
                        "type": "integer"
                    }
                },
                "type": "object"
            },
            "UpdateUserRequest": {
                "title": "Update User Request",
                "description": "Request body for updating a user",
                "properties": {
                    "f_name": {
                        "description": "Determine if the user is authorized to make this request.",
                        "type": "string"
                    },
                    "l_name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "current_password": {
                        "type": "string",
                        "format": "password",
                        "writeOnly": true
                    },
                    "password": {
                        "type": "string",
                        "format": "password",
                        "writeOnly": true
                    },
                    "password_confirmation": {
                        "type": "string",
                        "format": "password",
                        "writeOnly": true
                    },
                    "role_id": {
                        "type": "integer"
                    }
                },
                "type": "object"
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Users",
            "description": "Users"
        }
    ]
}